{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://djangoailab.github.io/pve-storage-guard/schema/v1alpha1/pve-inventory.json",
  "title": "PVE Storage Guard identity-safe inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "observedAt", "domainKey", "storageType", "resources"],
  "properties": {
    "schemaVersion": { "const": "guard.storage-slo.io/v1alpha1" },
    "kind": { "const": "PVEInventory" },
    "observedAt": { "type": "string", "format": "date-time" },
    "domainKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "storageType": { "const": "zfspool" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceKey", "root", "critical"],
        "properties": {
          "resourceKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "root": { "type": "boolean" },
          "critical": { "type": "boolean" }
        }
      }
    }
  }
}
